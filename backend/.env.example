# Copy this file to `.env` and fill in real values.
# Never commit the actual `.env` file to version control.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cryptosage

# Secret key used for future security-related features
SECRET_KEY=change-me-in-production

# Set to False in production
DEBUG=True
# CryptoSage configuration.
# Copy to .env and adjust as needed. Every value below has a sane
# default baked into config.py, so .env only needs to override what you
# actually want to change. Only the Phase 7 (RAG) keys are shown here;
# see config.py for the full list (database, uploads, ML, risk, etc).

# --- Explainable RAG engine (Phase 7) --------------------------------
RAG_KNOWLEDGE_BASE_DIR=rag/knowledge_base
RAG_CHROMA_PERSIST_DIR=rag/chroma_store
RAG_COLLECTION_NAME=cryptosage_knowledge_base
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Two-stage retrieval: ChromaDB fetches RAG_CANDIDATE_K candidates,
# the lightweight reranker narrows that down to RAG_TOP_K for the LLM.
RAG_CANDIDATE_K=8
RAG_TOP_K=5

# Reranker blend weights (must sum to ~1.0; not enforced, just documented):
#   final_score = w_sem*semantic + w_algo*algorithm_match
#               + w_risk*risk_factor_match + w_meta*source_metadata_match
RAG_RERANK_WEIGHT_SEMANTIC=0.60
RAG_RERANK_WEIGHT_ALGORITHM=0.20
RAG_RERANK_WEIGHT_RISK_FACTOR=0.10
RAG_RERANK_WEIGHT_METADATA=0.10

# --- Local LLM (Ollama) ----------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=180
