
# Copy to .env for local development.
# Never commit .env or put real production credentials in this file.

# --- Environment and security ---
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-me-in-production

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cryptosage
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# --- CORS ---
# Comma-separated frontend origins; no trailing slash is required.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Firmware uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=500
ALLOWED_FIRMWARE_EXTENSIONS=bin,img,elf
ALLOWED_FIRMWARE_MIME_TYPES=application/octet-stream,application/x-executable,application/x-elf,application/x-object

# --- Analysis output ---
ANALYSIS_OUTPUT_DIR=analysis_output

# --- Machine learning ---
ML_SAVED_MODELS_DIR=ml/saved_models
DATASET_PROCESSED_DIR=dataset/data/processed

# --- Risk assessment ---
RISK_CONFIG_PATH=ml/risk_config.json
RECOMMENDATION_RULES_PATH=ml/recommendation_rules.json

# --- RAG knowledge base and vector store ---
RAG_KNOWLEDGE_BASE_DIR=rag/knowledge_base
RAG_CHROMA_PERSIST_DIR=rag/chroma_store
RAG_COLLECTION_NAME=cryptosage_knowledge_base
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_CANDIDATE_K=8
RAG_TOP_K=5

# Reranker weights; should sum to approximately 1.0.
RAG_RERANK_WEIGHT_SEMANTIC=0.60
RAG_RERANK_WEIGHT_ALGORITHM=0.20
RAG_RERANK_WEIGHT_RISK_FACTOR=0.10
RAG_RERANK_WEIGHT_METADATA=0.10

# --- Local Ollama LLM ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=180
